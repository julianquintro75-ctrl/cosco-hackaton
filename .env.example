# Copia a .env para cambiar valores:  cp .env.example .env
API_PORT=8000
UI_PORT=8501
# Semilla de los datos sintéticos (cambiarla genera otro «mundo»; el reto usa 7)
COSCO_SEED=7
# Base de datos: ruta SQLite o URL «esquema://…» de un backend registrado (ver engine/repositorio.py)
# COSCO_REPO=/app/data/cosco.db
# Hora del reentrenamiento nocturno (perfil «ml»)
HORA_REENTRENAMIENTO=02:00
