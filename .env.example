# Copia a .env para cambiar valores:  cp .env.example .env
API_PORT=8000
UI_PORT=8501
WEB_PORT=4200
# Semilla de los datos sintéticos (cambiarla genera otro «mundo»; el reto usa 7)
COSCO_SEED=7
# Base de datos: ruta SQLite o URL «esquema://…» de un backend registrado (ver engine/repositorio.py)
# COSCO_REPO=/app/data/cosco.db
# Hora del reentrenamiento nocturno (perfil «ml»)
HORA_REENTRENAMIENTO=02:00

# --- Acceso (¡cambiar fuera de la demo!) ---
# Secreto de firma de sesiones (≥ 32 caracteres). Vacío = aleatorio por arranque (las sesiones mueren al reiniciar la API).
# COSCO_JWT_SECRET=
# Usuario semilla (se crea una vez, si no hay usuarios). Valores de demostración por defecto: jurado / Cosco-2026!
# COSCO_SEED_USER=jurado
# COSCO_SEED_PASSWORD=Cosco-2026!
# Cuadro «Acceso de demostración» en el login: déjalo vacío para ocultarlo
# COSCO_DEMO_USER=
# COSCO_DEMO_PASSWORD=

# --- Motores comparados (bench/comparar.py) · las claves van SOLO en tu .env, nunca en el repositorio ---
# Jev (TypeSafe). Sin clave, el motor B se reporta como «no medido».
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Motor C (LLM de propósito general), opcional
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
