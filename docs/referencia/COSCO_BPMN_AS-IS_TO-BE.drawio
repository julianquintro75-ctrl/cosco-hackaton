whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1496" y="1252" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_note" value="Cliente, COSCO y Proveedores son piscinas separadas porque son organizaciones distintas; se comunican solo con flujos de mensaje. Los tiempos reales se validarán con el equipo de operaciones." style="text;html=1;fillColor=none;strokeColor=none;fontSize=10.5;fontColor=#5B6472;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="1296" width="2932" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · TO-BE Proceso con el sistema" id="tobe"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="6890" pageHeight="1838" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;COSCO SHIPPING · Transporte terrestre · Proceso PROPUESTO (TO-BE)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#B7C0D8'&gt;Recomendación explicable y determinista, humano en el lazo y aprendizaje continuo. Niveles de servicio: Flexible (ventana de +3 días) · Estándar (balance) · Urgente (máxima confiabilidad + respaldo)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F1729;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="6890" height="90" as="geometry"/></mxCell><mxCell id="band0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5D9E0;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="6860" height="220" as="geometry"/></mxCell><mxCell id="lab0" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#5B6472'&gt;Importador / exportador&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9ECF2;strokeColor=#D5D9E0;fontColor=#0F1729;fontSize=11.5;align