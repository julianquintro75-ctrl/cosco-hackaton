"GPS / novedades" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t12" target="t12b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t13" target="c_w"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5480" y="1432"/><mxPoint x="5480" y="280"/></Array></mxGeometry></mxCell><mxCell id="e68" value="prueba de entrega" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="t13" target="t16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6055" y="1457"/><mxPoint x="6055" y="926"/><mxPoint x="6335" y="926"/></Array></mxGeometry></mxCell><mxCell id="e69" value="feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t15" target="t16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="strip_t69" value="&lt;b&gt;Reglas clave del proceso&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F1729;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1598" width="600" height="22" as="geometry"/></mxCell><mxCell id="strip69_0" value="&lt;b&gt;Costo total esperado&lt;/b&gt; = precio + P(retraso) × costo del retraso (penalidad, compensación, detención) + P(incidente) × costo del incidente + penalización por incertidumbre + penalización por concentración. &lt;b&gt;Margen&lt;/b&gt; = tarifa al cliente − costo total esperado: como la tarifa está fija por solicitud, minimizar uno es maximizar el otro." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1624" width="1696" height="78" as="geometry"/></mxCell><mxCell id="strip69_1" value="&lt;b&gt;Revisión detallada obligatoria&lt;/b&gt; si: nivel Urgente · confianza baja (pocos datos) · Top-1 y Top-2 casi empatados · sin opción ideal · carga de alto valor. &lt;b&gt;Escala a gerencia&lt;/b&gt; si el margen es negativo o ningún proveedor cumple el plazo con 90 % de confianza." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1742" y="1624" width="1696" height="78" as="geometry"/></mxCell><mxCell id="strip69_2" value='&lt;b&gt;Ranking determinista:&lt;/b&gt; la misma solicitud con los mismos datos produce siempre el mismo Top-3. La &lt;b&gt;exploración&lt;/b&gt; de proveedores con pocos datos va aparte, como "sugerencia de prueba" visible y opcional, solo en servicios Flexible de bajo riesgo. Nunca en Urgente.' style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="3453" y="1624" width="1696" height="78" as="geometry"/></mxCell><mxCell id="strip69_3" value="&lt;b&gt;Feedback sin formularios:&lt;/b&gt; (1) datos automáticos: GPS, prueba de entrega, incidentes, detención; (2) comportamiento del cliente: recompra, volumen, quejas; (3) explícito y opcional de 1 clic. &lt;b&gt;Filtros duros&lt;/b&gt; (vehículo, certificaciones) nunca se aprenden: son reglas fijas." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="5164" y="1624" width="1696" height="78" as="geometry"/></mxCell><mxCell id="leg_bg" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5D9E0;" vertex="1" parent="1"><mxGeometry x="0" y="1718" width="6890" height="92" as="geometry"/></mxCell><mxCell id="leg_s0" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA1AD;strokeWidth=1.5;fontColor=#1B1F27;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="24" y="1736" width="34" height="22" as="geometry"/></mxCell><mxCell id="leg_t0" value="Tarea operativa" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="66" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_s1" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="268" y="1736" width="34" height="22" as="geometry"/></mxCell><mxCell id="leg_t1" value="Tarea del sistema (IA / reglas)" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="310" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_s2" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C25E0F;strokeWidth=2;fontColor=#7A3A06;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="512" y="1736" width="34" height="22" as="geometry"/></mxCell><mxCell id="leg_t2" value="Decisión humana" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="554" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_s3" value="" style="shape=mxgraph.bpmn.gateway2;html=1;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="756" y="1736" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg_t3" value="Compuerta exclusiva" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="788" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_s4" value="" style="shape=mxgraph.bpmn.event;html=1;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=timer;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="990" y="1736" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg_t4" value="Inicio por tiempo / mensaje" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1022" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_s5" value="" style="shape=mxgraph.bpmn.event;html=1;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=message;fillColor=#FFFFFF;strokeColor=#2F6FED;fontSize=10;fontColor=#1D4FB8;" vertex="1" parent="1"><mxGeometry x="1224" y="1736" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg_t5" value="Evento intermedio de mensaje" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1256" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_s6" value="" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#F1F2F4;strokeColor=#5B6472;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="1458" y="1736" width="24" height="24" as="geometry"/></mxCell><mxCell id="leg_t6" value="Almacén de datos" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1490" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_m7" value="" style="endArrow=block;endFill=0;startArrow=oval;startFill=0;dashed=1;dashPattern=8 4;strokeColor=#3D63B8;html=1;shape=line;" vertex="1" parent="1"><mxGeometry x="1692" y="1744" width="40" height="6" as="geometry"/></mxCell><mxCell id="leg_t7" value="Flujo de mensaje" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#1B1F27;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1740" y="1730" width="190" height="36" as="geometry"/></mxCell><mxCell id="leg_note" value="Verde = camino principal · Naranja = excepción o reproceso · Gris punteado = lectura/escritura de datos · Azul punteado = mensaje entre organizaciones. La persona de operaciones siempre toma la decisión final; el sistema recomienda y explica." style="text;html=1;fillColor=none;strokeColor=none;fontSize=10.5;fontColor=#5B6472;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="1774" width="6842" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Lazo de control" id="lazo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;El sistema como lazo cerrado de control&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#B7C0D8'&gt;La red de proveedores es la planta; el motor de recomendación es el controlador; el feedback ajusta las decisiones.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F1729;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1720" height="90" as="geometry"/></mxCell><mxCell id="ref" value="&lt;b&gt;Referencia r(t)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Puntualidad objetivo por nivel (Flexible · Estándar · Urgente) y margen mínimo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#E8F0FE;strokeColor=#2F6FED;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="210" height="110" as="geometry"/></mxCell><mxCell id="sum" value="&lt;b&gt;Σ&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B1F27;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="50" height="50" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;Controlador&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Motor de recomendación: reglas + ML + estadística bayesiana + costo esperado (determinista)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#EEE8FB;strokeColor=#6D4AC7;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="250" height="110" as="geometry"/></mxCell><mxCell id="hitl" value="&lt;b&gt;Humano en el lazo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Operaciones aprueba o corrige; gerencia aprueba excepciones&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#FDEBD8;strokeColor=#C25E0F;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="210" height="110" as="geometry"/></mxCell><mxCell id="act" value="&lt;b&gt;Actuador&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Asignación del servicio al proveedor&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#F1F2F4;strokeColor=#5B6472;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="210" height="110" as="geometry"/></mxCell><mxCell id="plant" value="&lt;b&gt;Planta&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Red de proveedores + corredores viales de Colombia&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#E8F6EE;strokeColor=#1E8E5A;" vertex="1" parent="1"><mxGeometry x="1320" y="250" width="240" height="110" as="geometry"/></mxCell><mxCell id="dist" value="&lt;b&gt;Perturbaciones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Lluvias, derrumbes, paros, festivos, congestión en puerto&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#FDECEC;strokeColor=#D64545;" vertex="1" parent="1"><mxGeometry x="1320" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="sens" value="&lt;b&gt;Sensor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;GPS, prueba de entrega, incidentes, días de detención, recompra del cliente, feedback de 1 clic&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#FFF8DB;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="330" height="110" as="geometry"/></mxCell><mxCell id="upd" value="&lt;b&gt;Actualización amortiguada&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10.5px'&gt;Bayesiano en tiempo real · reentreno nocturno · pesos mensuales con aprobación&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=12;spacing=8;fontColor=#1B1F27;fillColor=#EEE8FB;strokeColor=#6D4AC7;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="340" height="110" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Salida y(t)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px'&gt;puntualidad y&lt;br&gt;margen reales&lt;/font&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="1580" y="370" width="120" height="60" as="geometry"/></mxCell><mxCell id="e1" value="r(t)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="ref" target="sum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="e(t)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="sum" target="ctrl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Top-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="ctrl" target="hitl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="u(t)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="hitl" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="act" target="plant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#C25E0F;fontColor=#C25E0F;" edge="1" parent="1" source="dist" target="plant"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="y(t)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="plant" target="sens"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="medición" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="sens" target="upd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="− realimentación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#C25E0F;fontColor=#C25E0F;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="upd" target="sum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="ajusta parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#C25E0F;fontColor=#C25E0F;dashed=1;dashPattern=6 4;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="upd" target="ctrl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cn" value="&lt;b&gt;Estabilidad:&lt;/b&gt; si el sistema castiga demasiado rápido a un proveedor por un solo fallo, el lazo oscila (lo deja sin servicios, no aprende si mejoró y luego lo premia de golpe). Para evitarlo: (1) &lt;b&gt;decaimiento temporal&lt;/b&gt; (vida media ≈ 90 días) como filtro pasa-bajos; (2) &lt;b&gt;suavizado bayesiano&lt;/b&gt; que exige evidencia antes de mover el puntaje; (3) &lt;b&gt;límites&lt;/b&gt; al cambio de pesos por ciclo; (4) &lt;b&gt;exploración controlada fuera del ranking&lt;/b&gt; para seguir observando proveedores con pocos datos. &lt;b&gt;Error:&lt;/b&gt; e(t) = puntualidad prometida − puntualidad real, por nivel de servicio y corredor." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1640" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 · Modelo de datos (ER)" id="er"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1212" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Modelo de datos del sistema de selección de proveedores&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#B7C0D8'&gt;Azul = datos maestros · Verde = operación · Morado = inteligencia y trazabilidad. 🔑 clave primaria · 🔗 clave foránea. Todas las relaciones son de uno a muchos.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F1729;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2120" height="90" as="geometry"/></mxCell><mxCell id="er_CLIENTE" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E8F0FE;strokeColor=#2F6FED;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="280" height="120" as="geometry"/></mxCell><mxCell id="er_CLIENTE_h" value="&lt;b&gt;CLIENTE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6FED;strokeColor=#2F6FED;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="er_CLIENTE"><mxGeometry x="0" y="0" width="280" height="30" as="geometry"/></mxCell><mxCell id="er_CLIENTE_0" value="&lt;b&gt;🔑 cliente_id&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;overflow=hidden;fontSize=11;fontColor=#1B1F27;" vertex="1" parent="er_CLIENTE"><mxGeometry x="0" y="33" width="280" height="21" as="geometry"/></mxCell><mxCell id="er_