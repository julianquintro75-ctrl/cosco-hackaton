ansportistas locales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9ECF2;strokeColor=#D5D9E0;fontColor=#0F1729;fontSize=11.5;align=center;verticalAlign=middle;horizontal=0;" vertex="1" parent="1"><mxGeometry x="30" y="862" width="40" height="240" as="geometry"/></mxCell><mxCell id="pool2" value="&lt;b&gt;Proveedores&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E6E4A;strokeColor=none;fontColor=#FFFFFF;fontSize=12.5;align=center;verticalAlign=middle;horizontal=0;" vertex="1" parent="1"><mxGeometry x="0" y="862" width="30" height="240" as="geometry"/></mxCell><mxCell id="poolf2" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#0F1729;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="862" width="2980" height="240" as="geometry"/></mxCell><mxCell id="a_s" value="Necesita mover&lt;br&gt;un contenedor" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=message;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="285" y="200" width="40" height="40" as="geometry"/></mxCell><mxCell id="a1" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt; &lt;br&gt;&lt;b&gt;Envía la solicitud&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;por correo, teléfono o WhatsApp, sin formato estándar&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA1AD;strokeWidth=1.5;fontColor=#1B1F27;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="170" width="200" height="100" as="geometry"/></mxCell><mxCell id="a10" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;9&lt;/b&gt;&lt;/font&gt; &lt;br&gt;&lt;b&gt;Recibe la carga&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;si llega tarde, se queja por correo&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA1AD;strokeWidth=1.5;fontColor=#1B1F27;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2275" y="170" width="200" height="100" as="geometry"/></mxCell><mxCell id="a_e" value="Servicio&lt;br&gt;terminado" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="2585" y="200" width="40" height="40" as="geometry"/></mxCell><mxCell id="o_s" value="Solicitud&lt;br&gt;recibida" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=message;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="515" y="466" width="40" height="40" as="geometry"/></mxCell><mxCell id="a2" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt; &lt;br&gt;&lt;b&gt;Lee y transcribe la solicitud&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;a mano; a veces faltan datos y hay que volver a preguntar&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D64545;strokeWidth=2;fontColor=#1B1F27;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="665" y="436" width="200" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt; &lt;br&gt;&lt;b&gt;Busca tarifas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;en Excel, correos y memoria personal&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D64545;strokeWidth=2;fontColor=#1B1F2