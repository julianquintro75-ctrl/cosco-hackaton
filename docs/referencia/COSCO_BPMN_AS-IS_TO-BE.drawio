"></mxGeometry></mxCell><mxCell id="e21" value="precio y capacidad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="asignación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a8" target="p_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="carga" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6472;strokeWidth=1.6;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;jettySize=auto;orthogonalLoop=1;strokeColor=#3D63B8;fontColor=#3D63B8;dashed=1;dashPattern=8 4;startArrow=oval;startFill=0;startSize=8;endArrow=block;endFill=0;endSize=9;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="strip_t23" value="&lt;b&gt;Puntos de dolor del proceso actual&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F1729;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1118" width="600" height="22" as="geometry"/></mxCell><mxCell id="strip23_0" value="&lt;b&gt;Lento.&lt;/b&gt; Cada solicitud exige comparar a mano más de diez proveedores, con llamadas y hojas de cálculo." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D64545;fontSize=11;fontColor=#8A1C1C;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1144" width="718" height="80" as="geometry"/></mxCell><mxCell id="strip23_1" value="&lt;b&gt;Inconsistente.&lt;/b&gt; Dos analistas pueden elegir distinto ante la misma solicitud y no se puede explicar por qué." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D64545;fontSize=11;fontColor=#8A1C1C;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="764" y="1144" width="718" height="80" as="geometry"/></mxCell><mxCell id="strip23_2" value="&lt;b&gt;Sin trazabilidad.&lt;/b&gt; No queda registro de las opciones consideradas ni del motivo de la elección." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D64545;fontSize=11;fontColor=#8A1C1C;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1498" y="1144" width="718" height="80" as="geometry"/></mxCell><mxCell id="strip23_3" value="&lt;b&gt;Sin aprendizaje.&lt;/b&gt; Un proveedor que empieza a fallar en un corredor se detecta tarde y la negociación se hace sin datos." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#D64545;fontSize=11;fontColor=#8A1C1C;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2232" y="1144" width="718" height="80" as="geometry"/></mxCell><mxCell id="leg_bg" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5D9E0;" vertex="1" parent="1"><mxGeometry x="0" y="1240" width="2980" height="92" as="geometry"/></mxCell><mxCell id="leg_s0" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColo