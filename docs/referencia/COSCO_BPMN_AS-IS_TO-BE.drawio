F1729;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="1332" width="6890" height="250" as="geometry"/></mxCell><mxCell id="s0" value="Necesita mover&lt;br&gt;carga" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=message;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="285" y="200" width="40" height="40" as="geometry"/></mxCell><mxCell id="t1" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt; &lt;br&gt;&lt;b&gt;Registra la solicitud&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;portal, correo o API: origen, destino, carga, vehículo, plazo y &lt;b&gt;nivel de servicio&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA1AD;strokeWidth=1.5;fontColor=#1B1F27;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="170" width="200" height="100" as="geometry"/></mxCell><mxCell id="c_w" value="Carga&lt;br&gt;entregada" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=message;fillColor=#FFFFFF;strokeColor=#2F6FED;fontSize=10;fontColor=#1D4FB8;" vertex="1" parent="1"><mxGeometry x="5460" y="200" width="40" height="40" as="geometry"/></mxCell><mxCell id="t14" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;14&lt;/b&gt;&lt;/font&gt; &lt;br&gt;&lt;b&gt;Recibe y verifica la carga&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA1AD;strokeWidth=1.5;fontColor=#1B1F27;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="5725" y="170" width="200" height="100" as="geometry"/></mxCell><mxCell id="g_fb" value="¿Responde el&lt;br&gt;feedback?" style="shap