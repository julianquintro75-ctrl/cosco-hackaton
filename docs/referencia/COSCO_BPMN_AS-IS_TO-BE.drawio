<mxfile host="app.diagrams.net" pages="4"><diagram name="1 · AS-IS Proceso actual" id="asis"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2980" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;COSCO SHIPPING · Transporte terrestre · Proceso ACTUAL (AS-IS)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#B7C0D8'&gt;Selección manual del proveedor, comparando uno por uno. Tareas con punto de dolor en rojo.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F1729;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2980" height="90" as="geometry"/></mxCell><mxCell id="band0" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5D9E0;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="2950" height="220" as="geometry"/></mxCell><mxCell id="lab0" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#5B6472'&gt;Importador / exportador&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9ECF2;strokeColor=#D5D9E0;fontColor=#0F1729;fontSize=11.5;align=center;verticalAlign=middle;horizontal=0;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="40" height="220" as="geometry"/></mxCell><mxCell id="pool0" value="&lt;b&gt;Cliente&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1D4FB8;strokeColor=none;fontColor=#FFFFFF;fontSize=12.5;align=center;verticalAlign=middle;horizontal=0;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="30" height="220" as="geometry"/></mxCell><mxCell id="poolf0" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#0F1729;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="2980" height="220" as="geometry"/></mxCell><mxCell id="band1" value=""