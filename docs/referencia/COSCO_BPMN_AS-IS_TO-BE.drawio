orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;strokeColor=#5B6472;strokeWidth=1.4;rounded=0;jumpStyle=arc;jumpSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="er_CORREDOR" target="er_ESTADISTICA_PROVEEDOR"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="16" y="540"/><mxPoint x="16" y="1060"/><mxPoint x="1230" y="1060"/></Array></mxGeometry></mxCell><mxCell id="strip_t19" value="&lt;b&gt;Cómo se usa&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F1729;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1096" width="600" height="22" as="geometry"/></mxCell><mxCell id="strip19_0" value="&lt;b&gt;Maestros:&lt;/b&gt; qué puede hacer cada proveedor (flota, certificaciones, tarifas por corredor). La capacidad se guarda como &lt;b&gt;historial de fotos&lt;/b&gt;, no solo el valor actual, para saber qué había disponible al momento de decidir." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1122" width="676" height="70" as="geometry"/></mxCell><mxCell id="strip19_1" value="&lt;b&gt;Operación:&lt;/b&gt; cada solicitud y lo que realmente pasó en el servicio (tiempos reales, detención, eventos en ruta, feedback). Es la fuente de las variables de los modelos." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="722" y="1122" width="676" height="70" as="geometry"/></mxCell><mxCell id="strip19_2" value="&lt;b&gt;Inteligencia:&lt;/b&gt; la recomendación guarda el Top-3 con su desglose y la versión del modelo; la decisión guarda qué eligió la persona y por qué. Las estadísticas por proveedor × corredor alimentan el ranking en tiempo real." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;fontSize=10.5;fontColor=#4A3B00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1414" y="1122" width="676" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>