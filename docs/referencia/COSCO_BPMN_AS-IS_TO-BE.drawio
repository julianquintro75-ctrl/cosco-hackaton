" y="531" width="50" height="50" as="geometry"/></mxCell><mxCell id="t7d" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;7d&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#C25E0F'&gt;&lt;b&gt;[HUMANO]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Elige otro proveedor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;motivo obligatorio en 1 clic (alimenta el aprendizaje)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C25E0F;strokeWidth=2;fontColor=#7A3A06;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="3655" y="506" width="200" height="100" as="geometry"/></mxCell><mxCell id="t8" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#C25E0F'&gt;&lt;b&gt;[HUMANO]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Asigna el servicio&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;la orden sale automáticamente al proveedor&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C25E0F;strokeWidth=2;fontColor=#7A3A06;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="3885" y="376" width="200" height="100" as="geometry"/></mxCell><mxCell id="t12c" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;12a&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#C25E0F'&gt;&lt;b&gt;[HUMANO]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Gestiona la contingencia&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;activa el respaldo e informa al cliente antes de que lo note&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C25E0F;strokeWidth=2;fontColor=#7A3A06;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="5725" y="441" width="200" height="100" as="geometry"/></mxCell><mxCell id="m_s" value="Mensual" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=timer;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="377" y="1161" width="40" height="40" as="geometry"/></mxCell><mxCell id="m1" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;M1&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#C25E0F'&gt;&lt;b&gt;[HUMANO]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Revisa los tableros&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;precios, tránsito, capacidad, vehículos, tendencias, Dureza y concentración&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C25E0F;strokeWidth=2;fontColor=#7A3A06;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="1131" width="200" height="100" as="geometry"/></mxCell><mxCell id="m2" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;M2&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#C25E0F'&gt;&lt;b&gt;[HUMANO]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Aprueba o rechaza ajustes de pesos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;propuestos por el sistema con evidencia&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#C25E0F;strokeWidth=2;fontColor=#7A3A06;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="665" y="1131" width="200" height="100" as="geometry"/></mxCell><mxCell id="m3" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;M3&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#C25E0F'&gt;&lt;b&gt;[HUMANO]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Negocia con proveedores&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;con datos por corredor y tipo de carga&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;ht