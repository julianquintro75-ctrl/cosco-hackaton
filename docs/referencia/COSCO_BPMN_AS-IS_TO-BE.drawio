nt style='font-size:9.5px' color='#4B5260'&gt;extrae campos y detecta datos faltantes o inconsistentes&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="665" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="g1" value="¿Datos&lt;br&gt;completos?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="816" width="50" height="50" as="geometry"/></mxCell><mxCell id="t3" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#5B6472'&gt;&lt;b&gt;[REGLAS]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Filtro de factibilidad&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;tipo de vehículo, capacidad, cobertura del corredor y certificaciones (IMO, reefer)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1125" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="g2" value="¿Hay proveedores&lt;br&gt;factibles?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="816" width="50" height="50" as="geometry"/></mxCell><mxCell id="t3b" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;3a&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Relajación escalonada&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;vehículo alterno → dividir carga → mover fecha; marca &quot;sin opción ideal&quot;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1585" y="856" width="200" height="100" as="geometry"/></mxCell><mxCell id="g3" value="¿Hay&lt;br&gt;alternativa?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1890" y="881" width="50" height="50" as="geometry"/></mxCell><mxCell id="t4" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Predice por proveedor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;P(a tiempo), tránsito P50/P90 y riesgo: ML + estadística bayesiana por corredor&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2045" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="t5" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Calcula costo esperado y Top-3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;precio + retraso esperado + riesgo + incertidumbre + concentración, según el nivel. &lt;b&gt;Determinista&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2275" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="t6" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Genera la explicación&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;los 7 factores, desglose del costo, SHAP, Índice de Dureza, alertas, descartados y sugerencia de prueba aparte&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="2505" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="g4" value="¿Requiere revisión&lt;br&gt;detallada?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2810" y="816" width="50" height="50" as="geometry"/></mxCell><mxCell id="db" value="Base de datos&lt;br&gt;proveedores · servicios&lt;br&gt;tarifas · capacidad&lt;br&gt;decisiones" style="shape=datastore;whiteSpace=wrap;html=1;fillColor=#F1F2F4;strokeColor=#5B6472;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="2430" y="922" width="120" height="72" as="geometry"/></mxCell><mxCell id="t9" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;9&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Registra la decisión y envía la orden&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;recomendación vs. elección, motivo y versión del modelo&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="4115" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="t9b" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;10&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Recibe la respuesta del proveedor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;confirmación de vehículo, placa y hora de cargue&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="4575" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="g7" value="¿Confirmó?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=top;verticalAlign=bottom;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="4880" y="816" width="50" height="50" as="geometry"/></mxCell><mxCell id="t10b" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;10a&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Reasigna al siguiente del ranking&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;y registra el rechazo en el historial del proveedor&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="4805" y="895" width="200" height="100" as="geometry"/></mxCell><mxCell id="t12b" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;12&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Monitorea el servicio en ruta&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;GPS y novedades; recalcula P(retraso) en tiempo real&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="5265" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="g8" value="¿Riesgo de&lt;br&gt;retraso?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;gwType=exclusive;fillColor=#FFFFFF;strokeColor=#2F6FED;strokeWidth=2;fontSize=10;fontColor=#1D4FB8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="5570" y="816" width="50" height="50" as="geometry"/></mxCell><mxCell id="t16" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;16&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Captura resultados&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;puntualidad, tiempos, incidentes, días de detención, feedback y recompra del cliente&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="6185" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="t17" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;17&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Actualiza en tiempo real&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;estadísticas bayesianas con decaimiento e Índice de Dureza por corredor&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="6415" y="791" width="200" height="100" as="geometry"/></mxCell><mxCell id="e_ok" value="Servicio cerrado&lt;br&gt;y aprendido" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="6725" y="821" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_s" value="Cada noche" style="shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=timer;fillColor=#E8F6EE;strokeColor=#1E8E5A;fontSize=10;fontColor=#1B1F27;" vertex="1" parent="1"><mxGeometry x="377" y="938" width="40" height="40" as="geometry"/></mxCell><mxCell id="n1" value="&lt;font style='font-size:9px' color='#8B919D'&gt;&lt;b&gt;N1&lt;/b&gt;&lt;/font&gt; &lt;font style='font-size:8.5px' color='#6D4AC7'&gt;&lt;b&gt;[IA]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Reentrena modelos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9.5px' color='#4B5260'&gt;validación temporal (pasado → reciente)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEE8FB;strokeColor=#6D4AC7;strokeWidth=2;fontColor=#3B2777;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="908" width="200" height="100" as="geometry"/></mxCell><mxCell id="ng" value="¿Supera al&lt;br&gt;modelo actual?" style="shape=mxgraph.bpmn.gateway2;html=1;verticalLabelPosition=bottom;verticalAlign=top;l