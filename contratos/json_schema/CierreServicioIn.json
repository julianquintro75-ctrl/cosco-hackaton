{
  "description": "Se envia al cerrar un servicio; dispara la actualizacion bayesiana inmediata.",
  "properties": {
    "servicio_id": {
      "title": "Servicio Id",
      "type": "string"
    },
    "entrega_real": {
      "format": "date-time",
      "title": "Entrega Real",
      "type": "string"
    },
    "a_tiempo": {
      "title": "A Tiempo",
      "type": "boolean"
    },
    "costo_final": {
      "title": "Costo Final",
      "type": "integer"
    },
    "dias_detencion": {
