      "title": "Dias Detencion",
      "type": "integer"
    },
    "hubo_incidente": {
      "default": false,
      "title": "Hubo Incidente",
      "type": "boolean"
    },
    "feedback_puntaje": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feedback Puntaje"
    },
    "feedback_causa": {
      "anyOf": [
        {
          "enum": [
            "proveedor",
            "cliente",
            "puerto",
            "clima",
            "otro"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feedback Causa"
